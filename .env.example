# Environment
NODE_ENV=development

# Application
CLIENT_URL=http://localhost:5173
API_URL=http://localhost:5000

# Database
MONGODB_URI=mongodb://localhost:27017/staysphere-ai

# Redis
REDIS_URL=redis://localhost:6379

# JWT
JWT_ACCESS_SECRET=generate-a-secure-secret-here
JWT_REFRESH_SECRET=generate-another-secure-secret-here
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=7d

# Razorpay (TEST mode)
RAZORPAY_KEY_ID=your_razorpay_test_key_id
RAZORPAY_KEY_SECRET=your_razorpay_test_key_secret
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret

# AI Provider
AI_PROVIDER=kiro
AI_MODEL=claude-sonnet-4.5
AI_API_KEY=your_ai_provider_api_key

# Identity Verification
IDENTITY_PROVIDER=mock
IDENTITY_PROVIDER_KEY=your_identity_provider_key
IDENTITY_WEBHOOK_SECRET=your_identity_webhook_secret

# Server
PORT=5000
