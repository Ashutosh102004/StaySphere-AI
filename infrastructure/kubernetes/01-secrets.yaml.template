---
# NOTE: This is a template. In production, use one of:
# 1. kubectl create secret generic staysphere-secrets --from-literal=...
# 2. Sealed Secrets (https://github.com/bitnami-labs/sealed-secrets)
# 3. External Secrets Operator
# 4. Cloud-native secret management (AWS Secrets Manager, Azure Key Vault, GCP Secret Manager)
#
# NEVER commit real secrets to git. This template shows the required secret keys.

apiVersion: v1
kind: Secret
metadata:
  name: staysphere-secrets
  namespace: staysphere
type: Opaque
stringData:
  # JWT Secrets (REQUIRED - generate with: openssl rand -base64 32)
  JWT_ACCESS_SECRET: "REPLACE_WITH_SECURE_SECRET_MIN_32_CHARS"
  JWT_REFRESH_SECRET: "REPLACE_WITH_SECURE_SECRET_MIN_32_CHARS"

  # MongoDB Credentials
  MONGODB_USER: "staysphere-admin"
  MONGODB_PASSWORD: "REPLACE_WITH_SECURE_PASSWORD"
  MONGODB_ROOT_PASSWORD: "REPLACE_WITH_SECURE_PASSWORD"

  # Redis Password (if using authentication)
  REDIS_PASSWORD: "REPLACE_WITH_SECURE_PASSWORD"

  # Payment Gateway
  RAZORPAY_KEY_ID: "REPLACE_WITH_RAZORPAY_KEY_ID"
  RAZORPAY_KEY_SECRET: "REPLACE_WITH_RAZORPAY_SECRET"
  RAZORPAY_WEBHOOK_SECRET: "REPLACE_WITH_RAZORPAY_WEBHOOK_SECRET"

  # AI Provider
  AI_API_KEY: "REPLACE_WITH_AI_PROVIDER_API_KEY"

  # Identity Verification Provider
  IDENTITY_PROVIDER_KEY: "REPLACE_WITH_IDENTITY_PROVIDER_KEY"
  IDENTITY_WEBHOOK_SECRET: "REPLACE_WITH_IDENTITY_WEBHOOK_SECRET"
